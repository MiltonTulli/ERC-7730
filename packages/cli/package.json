{
  "name": "@erc7730/cli",
  "version": "0.2.0",
  "description": "CLI to generate, lint, preview, and diff ERC-7730 descriptors",
  "type": "module",
  "bin": {
    "erc7730": "./dist/index.js"
  },
  "files": ["dist", "!dist/**/*.map", "!dist/**/*.tsbuildinfo"],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@erc7730/sdk": "workspace:*",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["ethereum", "erc7730", "clear-signing", "cli"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MiltonTulli/ERC-7730"
  },
  "author": "Milton Tulli <milton.tulli@gmail.com>",
  "homepage": "https://github.com/MiltonTulli/ERC-7730"
}
