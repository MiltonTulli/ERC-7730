{
  "name": "@erc7730/sdk",
  "version": "0.11.0",
  "description": "Decode blockchain transactions into human-readable format using ERC-7730 standard",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./attest": {
      "types": "./dist/attest.d.ts",
      "import": "./dist/attest.js"
    },
    "./generate": {
      "types": "./dist/generate.d.ts",
      "import": "./dist/generate.js"
    },
    "./sourcify": {
      "types": "./dist/sourcify.d.ts",
      "import": "./dist/sourcify.js"
    },
    "./known-data": {
      "types": "./dist/known-data.d.ts",
      "import": "./dist/known-data.js"
    }
  },
  "files": ["dist", "!dist/**/*.map", "!dist/**/*.tsbuildinfo"],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "schema:types": "node scripts/generate-schema-types.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:consumer": "tsc -p type-tests/tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ox": "^1.8.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.2.0",
    "json-schema-to-typescript": "15.0.4",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "^5.3.3",
    "viem": "^2.21.0",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "ethereum",
    "erc7730",
    "clear-signing",
    "transaction",
    "decoder",
    "human-readable",
    "web3",
    "blockchain"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MiltonTulli/ERC-7730"
  },
  "author": "Milton Tulli <milton.tulli@gmail.com>",
  "homepage": "https://github.com/MiltonTulli/ERC-7730"
}
